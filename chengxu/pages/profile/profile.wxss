/* pages/profile/profile.wxss */

/* 用户信息头部 */
.user-header {
  padding: 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 15rpx;
}

.user-status {
  margin-bottom: 10rpx;
}

.vip-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.vip-active {
  background: linear-gradient(135deg, #D4AF37, #F4E4A6);
  color: #000000;
}

.vip-inactive {
  background: rgba(255, 255, 255, 0.1);
  color: #999999;
}

.user-actions {
  align-self: flex-start;
}

.edit-profile-btn {
  padding: 15rpx 30rpx;
  font-size: 26rpx;
}

/* 登录提示 */
.login-prompt {
  text-align: center;
  padding: 60rpx 40rpx;
}

.login-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}

.login-text {
  display: block;
  font-size: 32rpx;
  color: #CCCCCC;
  margin-bottom: 40rpx;
}

.login-btn {
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

/* VIP特权 */
.vip-privileges {
  padding: 40rpx;
}

.privileges-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
  margin-top: 30rpx;
}

.privilege-item {
  flex: 1;
  min-width: 150rpx;
  text-align: center;
  padding: 30rpx 20rpx;
  background: rgba(212, 175, 55, 0.05);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.privilege-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 20rpx;
}

.privilege-title {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: bold;
}

/* VIP申请 */
.vip-application {
  padding: 40rpx;
}

.vip-promo {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.vip-crown {
  width: 80rpx;
  height: 80rpx;
}

.vip-content {
  flex: 1;
}

.vip-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 15rpx;
}

.vip-description {
  display: block;
  font-size: 26rpx;
  color: #CCCCCC;
  line-height: 1.4;
  margin-bottom: 25rpx;
}

.vip-apply-btn {
  padding: 15rpx 40rpx;
  font-size: 26rpx;
}

/* 我的订单 */
.my-orders {
  padding: 40rpx;
}

.orders-header {
  margin-bottom: 30rpx;
}

.view-all {
  font-size: 26rpx;
  text-decoration: underline;
}

.order-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
}

.order-tab {
  flex: 1;
  text-align: center;
  padding: 15rpx 20rpx;
  font-size: 26rpx;
  color: #999999;
  border-radius: 10rpx;
  transition: all 0.3s ease;
}

.order-tab.active {
  background: linear-gradient(135deg, #D4AF37, #F4E4A6);
  color: #000000;
  font-weight: bold;
}

.orders-list {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.order-item {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
  transition: all 0.3s ease;
}

.order-item:active {
  transform: scale(0.98);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-number {
  font-size: 26rpx;
  color: #D4AF37;
  font-weight: bold;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 15rpx;
  border-radius: 15rpx;
  font-weight: bold;
}

.order-status.pending {
  background: rgba(255, 193, 7, 0.2);
  color: #FFC107;
}

.order-status.paid {
  background: rgba(76, 175, 80, 0.2);
  color: #4CAF50;
}

.order-status.shipped {
  background: rgba(33, 150, 243, 0.2);
  color: #2196F3;
}

.order-status.delivered {
  background: rgba(156, 39, 176, 0.2);
  color: #9C27B0;
}

.order-status.cancelled {
  background: rgba(244, 67, 54, 0.2);
  color: #F44336;
}

.order-product {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.order-product-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
}

.order-product-info {
  flex: 1;
}

.order-product-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.order-product-specs {
  display: block;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.order-product-price {
  font-size: 26rpx;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 15rpx;
}

.order-action-btn {
  padding: 12rpx 25rpx;
  font-size: 24rpx;
}

/* 空状态 */
.empty-orders, .empty-favorites {
  text-align: center;
  padding: 60rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 我的收藏 */
.my-favorites {
  padding: 40rpx;
}

.favorites-header {
  margin-bottom: 30rpx;
}

.favorites-scroll {
  width: 100%;
}

.favorites-list {
  display: flex;
  gap: 25rpx;
  padding: 0 20rpx;
}

.favorite-item {
  width: 200rpx;
  text-align: center;
}

.favorite-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 15rpx;
  margin-bottom: 15rpx;
}

.favorite-name {
  display: block;
  font-size: 26rpx;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.favorite-price {
  font-size: 28rpx;
}

/* 服务中心 */
.service-center {
  padding: 40rpx;
}

.service-grid {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-top: 30rpx;
}

.service-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
  transition: all 0.3s ease;
}

.service-item:active {
  background: rgba(212, 175, 55, 0.05);
}

.service-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 25rpx;
}

.service-title {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
}

.service-arrow {
  font-size: 24rpx;
  color: #999999;
}

/* 设置 */
.settings {
  padding: 40rpx;
}

.settings-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-top: 30rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
  transition: all 0.3s ease;
}

.setting-item:active {
  background: rgba(212, 175, 55, 0.05);
}

.setting-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 25rpx;
}

.setting-title {
  flex: 1;
  font-size: 28rpx;
  color: #FFFFFF;
}

.setting-value {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.setting-text {
  font-size: 24rpx;
  color: #999999;
}

.setting-arrow {
  font-size: 24rpx;
  color: #999999;
}

/* 关于我们 */
.about-section {
  padding: 40rpx;
}

.about-content {
  margin-top: 30rpx;
}

.about-text {
  font-size: 26rpx;
  color: #CCCCCC;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.contact-info {
  margin-bottom: 30rpx;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.contact-label {
  font-size: 26rpx;
  color: #CCCCCC;
}

.contact-value {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.app-version {
  text-align: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.version-text {
  font-size: 22rpx;
  color: #999999;
}