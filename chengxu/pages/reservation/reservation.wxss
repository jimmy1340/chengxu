/* pages/reservation/reservation.wxss */

/* 进度条样式 */
.progress-bar {
  padding: 30rpx 20rpx;
}

.progress-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.step-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  transition: all 0.3s ease;
}

.step.active .step-circle {
  background: linear-gradient(135deg, #D4AF37, #F4E4A6);
  color: #000000;
}

.step-text {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}

.step.active .step-text {
  color: #D4AF37;
  font-weight: bold;
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 20rpx;
  margin-bottom: 45rpx;
  transition: all 0.3s ease;
}

.step-line.active {
  background: linear-gradient(90deg, #D4AF37, #F4E4A6);
}

/* 产品确认样式 */
.product-confirmation {
  padding: 40rpx;
}

.product-summary {
  display: flex;
  gap: 30rpx;
  margin: 30rpx 0;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.product-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 15rpx;
}

.product-details {
  flex: 1;
}

.product-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 15rpx;
}

.selected-options {
  margin: 20rpx 0;
}

.option-item {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.option-label {
  font-size: 26rpx;
  color: #CCCCCC;
}

.option-value {
  font-size: 26rpx;
  color: #D4AF37;
  font-weight: bold;
}

.stock-warning {
  margin-top: 20rpx;
  padding: 15rpx;
  background: rgba(255, 193, 7, 0.1);
  border-radius: 10rpx;
  border: 1rpx solid rgba(255, 193, 7, 0.3);
}

.warning-text {
  font-size: 24rpx;
  color: #FFC107;
}

/* 数量选择器 */
.quantity-selector {
  margin: 30rpx 0;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
}

.selector-label {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 15rpx;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4AF37, #F4E4A6);
  color: #000000;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quantity-btn[disabled] {
  background: rgba(255, 255, 255, 0.1);
  color: #666666;
}

.quantity-display {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  min-width: 60rpx;
  text-align: center;
}

.quantity-note {
  font-size: 24rpx;
}

/* 预订说明 */
.reservation-notice {
  margin-top: 30rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.notice-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 20rpx;
}

.notice-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.notice-item {
  font-size: 26rpx;
  color: #CCCCCC;
  line-height: 1.4;
}

/* 表单样式 */
.user-info-form {
  padding: 40rpx;
}

.form-section {
  margin-bottom: 40rpx;
}

.form-section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 30rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid rgba(212, 175, 55, 0.2);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #FFFFFF;
  margin-bottom: 15rpx;
}

.form-input, .form-textarea {
  width: 100%;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 15rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus, .form-textarea:focus {
  border-color: #D4AF37;
  background: rgba(212, 175, 55, 0.05);
}

.form-input::placeholder, .form-textarea::placeholder {
  color: #999999;
}

.form-textarea {
  min-height: 120rpx;
  resize: none;
}

/* VIP升级 */
.vip-upgrade {
  padding: 30rpx;
  background: rgba(212, 175, 55, 0.05);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  text-align: center;
}

.vip-notice {
  display: block;
  font-size: 28rpx;
  color: #CCCCCC;
  margin-bottom: 20rpx;
}

.vip-apply-btn {
  padding: 15rpx 40rpx;
  font-size: 26rpx;
}

/* 订单摘要 */
.order-summary {
  padding: 40rpx;
}

.summary-section {
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.summary-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 25rpx;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.item-label {
  font-size: 28rpx;
  color: #CCCCCC;
}

.item-value {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.total-line {
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
  padding-top: 20rpx;
  margin-top: 15rpx;
}

.total-price {
  font-size: 36rpx;
  color: #D4AF37;
}

/* 协议部分 */
.agreement-section {
  margin-top: 30rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
}

.agreement-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.agreement-text {
  font-size: 26rpx;
  color: #CCCCCC;
}

.agreement-link {
  font-size: 26rpx;
  color: #D4AF37;
  text-decoration: underline;
}

/* 倒计时 */
.countdown-timer {
  padding: 30rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(212, 175, 55, 0.05));
}

.countdown-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 20rpx;
}

.countdown-display {
  margin: 20rpx 0;
}

.countdown-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.countdown-notice {
  font-size: 24rpx;
  color: #999999;
}

/* 步骤操作按钮 */
.step-actions {
  display: flex;
  gap: 30rpx;
  padding: 40rpx 20rpx;
}

.step-btn {
  flex: 1;
  padding: 25rpx;
  font-size: 32rpx;
  border-radius: 50rpx;
}

.confirm-btn {
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0.4); }
  70% { box-shadow: 0 0 0 20rpx rgba(212, 175, 55, 0); }
  100% { box-shadow: 0 0 0 0 rgba(212, 175, 55, 0); }
}

/* 成功页面 */
.success-page {
  padding: 60rpx 20rpx;
  text-align: center;
}

.success-content {
  max-width: 600rpx;
  margin: 0 auto;
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 40rpx;
}

.success-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 20rpx;
}

.success-message {
  display: block;
  font-size: 28rpx;
  color: #CCCCCC;
  margin-bottom: 50rpx;
  line-height: 1.5;
}

.order-info {
  padding: 40rpx;
  margin-bottom: 50rpx;
  text-align: center;
}

.order-title {
  display: block;
  font-size: 30rpx;
  color: #D4AF37;
  margin-bottom: 20rpx;
}

.order-number {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.order-notice {
  font-size: 24rpx;
  color: #999999;
}

.next-steps {
  margin-bottom: 50rpx;
  text-align: left;
}

.steps-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 30rpx;
  text-align: center;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.step-item {
  font-size: 26rpx;
  color: #CCCCCC;
  line-height: 1.4;
  padding-left: 20rpx;
}

.action-buttons {
  display: flex;
  gap: 30rpx;
}