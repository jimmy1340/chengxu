/* pages/index/index.wxss */

/* 轮播图样式 */
.hero-swiper {
  height: 500rpx;
  position: relative;
  margin-bottom: 40rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.7) 100%);
  display: flex;
  align-items: flex-end;
  padding: 60rpx 40rpx;
}

.hero-content {
  width: 100%;
}

.hero-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #FFFFFF;
  letter-spacing: 6rpx;
  margin-bottom: 20rpx;
}

.hero-subtitle {
  display: block;
  font-size: 32rpx;
  color: #D4AF37;
  letter-spacing: 2rpx;
}

/* 快速入口样式 */
.entry-title {
  margin-bottom: 40rpx;
}

.entry-grid {
  display: flex;
  gap: 30rpx;
}

.entry-item {
  flex: 1;
  text-align: center;
  padding: 40rpx 20rpx;
  transition: all 0.3s ease;
}

.entry-item:active {
  transform: scale(0.95);
}

.entry-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.entry-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.entry-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

/* 产品展示样式 */
.products-section {
  margin-bottom: 60rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.view-more {
  font-size: 28rpx;
  text-decoration: underline;
}

.products-scroll {
  width: 100%;
  white-space: nowrap;
}

.products-list {
  display: flex;
  gap: 30rpx;
  padding: 0 20rpx;
}

.product-card {
  width: 350rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
  transition: all 0.3s ease;
}

.product-card:active {
  transform: translateY(-10rpx);
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.4);
}

.product-image-container {
  position: relative;
  height: 280rpx;
}

.product-image {
  width: 100%;
  height: 100%;
}

.stock-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(212, 175, 55, 0.9);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.stock-text {
  font-size: 22rpx;
  color: #000000;
  font-weight: bold;
}

.product-info {
  padding: 30rpx;
}

.product-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.product-description {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.product-price-row {
  align-items: center;
}

.reserve-btn {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

/* 品牌特色样式 */
.brand-features {
  margin-bottom: 60rpx;
}

.features-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
  margin-top: 30rpx;
}

.feature-item {
  flex: 1;
  min-width: 200rpx;
  text-align: center;
  padding: 30rpx 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.feature-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 20rpx;
}

.feature-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
}

/* VIP专享样式 */
.vip-section {
  text-align: center;
  background: linear-gradient(135deg, rgba(212, 175, 55, 0.1) 0%, rgba(212, 175, 55, 0.05) 100%);
}

.vip-content {
  padding: 20rpx;
}

.vip-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
}

.vip-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #D4AF37;
  margin-bottom: 15rpx;
}

.vip-desc {
  display: block;
  font-size: 28rpx;
  color: #CCCCCC;
  margin-bottom: 30rpx;
  line-height: 1.4;
}

.vip-btn {
  width: 300rpx;
}

/* VIP专享区域 */
.vip-exclusive {
  margin-bottom: 60rpx;
}

.vip-header {
  margin-bottom: 30rpx;
}

.vip-badge {
  width: 60rpx;
  height: 60rpx;
}

.exclusive-products {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.exclusive-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  transition: all 0.3s ease;
}

.exclusive-item:active {
  transform: scale(0.98);
}

.exclusive-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 15rpx;
  margin-right: 30rpx;
}

.exclusive-info {
  flex: 1;
}

.exclusive-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.exclusive-price {
  font-size: 36rpx;
}

/* 浮动按钮 */
.floating-reserve {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  z-index: 1000;
}

.floating-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  font-size: 24rpx;
  line-height: 1.2;
  box-shadow: 0 8rpx 32rpx rgba(212, 175, 55, 0.5);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}