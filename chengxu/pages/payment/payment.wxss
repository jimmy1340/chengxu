/* pages/payment/payment.wxss */

/* 订单信息 */
.order-info {
  padding: 40rpx;
}

.order-header {
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.order-number {
  display: block;
  font-size: 28rpx;
  color: #D4AF37;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999999;
}

.product-info {
  display: flex;
  gap: 30rpx;
  margin-bottom: 30rpx;
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 15rpx;
}

.product-details {
  flex: 1;
}

.product-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.product-specs {
  display: block;
  font-size: 24rpx;
  margin-bottom: 15rpx;
}

.quantity-price {
  display: flex;
  gap: 30rpx;
}

.quantity, .unit-price {
  font-size: 26rpx;
  color: #CCCCCC;
}

.amount-summary {
  margin-top: 30rpx;
}

.amount-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.amount-label {
  font-size: 28rpx;
  color: #CCCCCC;
}

.amount-value {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.total-amount {
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
  padding-top: 20rpx;
  margin-top: 15rpx;
}

.total-amount .amount-value {
  font-size: 36rpx;
  color: #D4AF37;
}

/* 收货信息 */
.delivery-info {
  padding: 40rpx;
}

.address-info {
  margin-bottom: 30rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
}

.address-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.recipient-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.recipient-phone {
  font-size: 26rpx;
  color: #D4AF37;
}

.recipient-address {
  font-size: 26rpx;
  color: #CCCCCC;
  line-height: 1.4;
}

.delivery-options {
  margin-top: 30rpx;
}

.options-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.option-item:has(radio:checked) {
  border-color: #D4AF37;
  background: rgba(212, 175, 55, 0.05);
}

.option-content {
  flex: 1;
  margin-left: 20rpx;
}

.option-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.option-desc {
  display: block;
  font-size: 24rpx;
  margin-bottom: 5rpx;
}

.option-fee {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: bold;
}

/* 支付方式 */
.payment-methods {
  padding: 40rpx;
}

.method-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.method-item:has(radio:checked) {
  border-color: #D4AF37;
  background: rgba(212, 175, 55, 0.05);
}

.method-icon {
  width: 50rpx;
  height: 50rpx;
  margin: 0 20rpx;
}

.method-content {
  flex: 1;
}

.method-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.method-desc {
  display: block;
  font-size: 24rpx;
  margin-bottom: 5rpx;
}

.method-discount {
  font-size: 24rpx;
  font-weight: bold;
}

.method-status {
  font-size: 22rpx;
  color: #D4AF37;
  background: rgba(212, 175, 55, 0.2);
  padding: 8rpx 15rpx;
  border-radius: 15rpx;
}

/* 优惠券 */
.coupons-section {
  padding: 40rpx;
}

.coupon-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.2);
}

.coupon-text {
  font-size: 28rpx;
  color: #FFFFFF;
}

.coupon-save {
  font-size: 26rpx;
  font-weight: bold;
}

.coupon-arrow {
  font-size: 24rpx;
  color: #999999;
}

/* 发票信息 */
.invoice-section {
  padding: 40rpx;
}

.invoice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.invoice-form {
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
  color: #FFFFFF;
  font-size: 26rpx;
  box-sizing: border-box;
}

.picker-display {
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 10rpx;
  color: #FFFFFF;
  font-size: 26rpx;
}

/* 安全提示 */
.security-notice {
  padding: 0 20rpx;
}

.notice-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  padding: 20rpx;
  background: rgba(76, 175, 80, 0.1);
  border-radius: 15rpx;
  border: 1rpx solid rgba(76, 175, 80, 0.2);
}

.security-icon {
  width: 30rpx;
  height: 30rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #4CAF50;
}

/* 底部支付 */
.payment-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
  padding: 20rpx;
  z-index: 1000;
}

.payment-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-left {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.total-label {
  font-size: 28rpx;
  color: #CCCCCC;
}

.total-amount {
  font-size: 40rpx;
  font-weight: bold;
}

.pay-button {
  padding: 25rpx 60rpx;
  font-size: 32rpx;
  border-radius: 50rpx;
  min-width: 240rpx;
}

/* 优惠券弹窗 */
.coupon-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  background: #000000;
  border-radius: 30rpx 30rpx 0 0;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.modal-close {
  font-size: 40rpx;
  color: #999999;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-list {
  padding: 20rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.coupon-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 15rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 15rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.coupon-item.selected {
  border-color: #D4AF37;
  background: rgba(212, 175, 55, 0.1);
}

.coupon-info {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.coupon-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #D4AF37;
  min-width: 120rpx;
}

.coupon-details {
  flex: 1;
}

.coupon-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.coupon-condition, .coupon-expiry {
  display: block;
  font-size: 22rpx;
  margin-bottom: 5rpx;
}

.coupon-status {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: bold;
}