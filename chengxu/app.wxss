/**app.wxss**/
/* 全局样式 - DIOR高端奢侈品风格 */

page {
  background-color: #000000;
  color: #FFFFFF;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

/* 主要颜色定义 */
.primary-bg { background-color: #000000; }
.secondary-bg { background-color: #FFFFFF; }
.accent-bg { background-color: #D4AF37; }
.primary-text { color: #FFFFFF; }
.secondary-text { color: #000000; }
.accent-text { color: #D4AF37; }
.muted-text { color: #999999; }

/* 容器样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
}

.page-container {
  background: linear-gradient(180deg, #000000 0%, #1a1a1a 100%);
  min-height: 100vh;
}

/* 卡片样式 */
.luxury-card {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(212, 175, 55, 0.3);
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 0;
  backdrop-filter: blur(10px);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #D4AF37 0%, #F4E4A6 100%);
  color: #000000;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(212, 175, 55, 0.4);
  transition: all 0.3s ease;
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 15rpx rgba(212, 175, 55, 0.6);
}

.btn-secondary {
  background: transparent;
  color: #D4AF37;
  border: 2rpx solid #D4AF37;
  border-radius: 50rpx;
  padding: 18rpx 38rpx;
  font-size: 30rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.btn-secondary:active {
  background: rgba(212, 175, 55, 0.1);
}

/* 文本样式 */
.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-align: center;
  margin: 30rpx 0;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 36rpx;
  font-weight: 500;
  color: #D4AF37;
  margin: 20rpx 0;
}

.description {
  font-size: 28rpx;
  color: #CCCCCC;
  line-height: 1.6;
  margin: 15rpx 0;
}

.price {
  font-size: 40rpx;
  font-weight: bold;
  color: #D4AF37;
  font-family: 'Georgia', serif;
}

/* 图片样式 */
.product-image {
  width: 100%;
  border-radius: 15rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.5);
}

.avatar {
  border-radius: 50%;
  border: 3rpx solid #D4AF37;
}

/* 动画效果 */
.fade-in {
  animation: fadeIn 0.6s ease-in;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.slide-up {
  animation: slideUp 0.8s ease-out;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(50rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 渐变分割线 */
.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #D4AF37 50%, transparent 100%);
  margin: 40rpx 0;
}

/* Flex布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

/* 响应式间距 */
.margin-small { margin: 15rpx; }
.margin-medium { margin: 30rpx; }
.margin-large { margin: 60rpx; }

.padding-small { padding: 15rpx; }
.padding-medium { padding: 30rpx; }
.padding-large { padding: 60rpx; }

/* 状态样式 */
.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.loading {
  position: relative;
  overflow: hidden;
}

.loading::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(212, 175, 55, 0.3), transparent);
  animation: loading 1.5s infinite;
}

@keyframes loading {
  to { left: 100%; }
}