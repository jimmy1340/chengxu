/* pages/product-detail/product-detail.wxss */

/* 产品图片展示 */
.product-gallery {
  position: relative;
  height: 600rpx;
  margin-bottom: 30rpx;
}

.gallery-swiper {
  width: 100%;
  height: 100%;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.stock-status {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  padding: 15rpx 25rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(10px);
}

.in-stock {
  background: rgba(76, 175, 80, 0.8);
}

.out-stock {
  background: rgba(244, 67, 54, 0.8);
}

.stock-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 产品基本信息 */
.product-info {
  padding: 40rpx;
}

.product-header {
  margin-bottom: 30rpx;
}

.product-title {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
  line-height: 1.3;
}

.product-price-section {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}

.current-price {
  font-size: 48rpx;
}

.original-price {
  font-size: 32rpx;
  color: #999999;
  text-decoration: line-through;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 30rpx;
}

.tag {
  padding: 10rpx 20rpx;
  background: rgba(212, 175, 55, 0.2);
  border: 1rpx solid #D4AF37;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #D4AF37;
}

.product-description {
  margin-bottom: 30rpx;
}

.description-text {
  font-size: 28rpx;
  color: #CCCCCC;
  line-height: 1.6;
}

.stock-info {
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
}

.stock-label {
  font-size: 26rpx;
  color: #FFFFFF;
}

.stock-bar {
  flex: 1;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  margin: 0 20rpx;
  overflow: hidden;
}

.stock-progress {
  height: 100%;
  background: linear-gradient(90deg, #D4AF37, #F4E4A6);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.stock-count {
  font-size: 24rpx;
  color: #D4AF37;
  font-weight: bold;
}

/* 产品规格 */
.product-specs {
  padding: 40rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 30rpx;
}

.specs-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.spec-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.spec-name {
  font-size: 28rpx;
  color: #CCCCCC;
}

.spec-value {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}

/* 产品故事 */
.product-story {
  padding: 40rpx;
}

.story-content {
  margin-top: 30rpx;
}

.story-image {
  width: 100%;
  border-radius: 15rpx;
  margin-bottom: 30rpx;
}

.story-text {
  font-size: 28rpx;
  color: #CCCCCC;
  line-height: 1.6;
}

/* 选择规格 */
.product-options {
  padding: 40rpx;
}

.options-list {
  margin-top: 30rpx;
}

.option-group {
  margin-bottom: 40rpx;
}

.option-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 20rpx;
}

.option-values {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.option-item {
  padding: 15rpx 25rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 25rpx;
  transition: all 0.3s ease;
}

.option-item.selected {
  border-color: #D4AF37;
  background: rgba(212, 175, 55, 0.1);
}

.option-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

/* 用户评价 */
.product-reviews {
  padding: 40rpx;
}

.reviews-header {
  margin-bottom: 30rpx;
}

.rating-summary {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rating-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #D4AF37;
}

.rating-stars {
  display: flex;
  gap: 5rpx;
}

.star {
  width: 20rpx;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

.star.filled {
  background: #D4AF37;
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.review-item {
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 15rpx;
  border: 1rpx solid rgba(212, 175, 55, 0.1);
}

.review-header {
  margin-bottom: 20rpx;
}

.reviewer-info {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.reviewer-avatar {
  width: 60rpx;
  height: 60rpx;
}

.reviewer-name {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.review-rating {
  display: flex;
  gap: 5rpx;
}

.review-content {
  display: block;
  font-size: 26rpx;
  color: #CCCCCC;
  line-height: 1.5;
  margin-bottom: 15rpx;
}

.review-time {
  font-size: 22rpx;
}

/* 推荐产品 */
.recommended-products {
  padding: 0 20rpx;
}

.recommended-scroll {
  margin-top: 30rpx;
}

.recommended-list {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx;
}

.recommended-item {
  width: 200rpx;
  text-align: center;
}

.recommended-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 15rpx;
  margin-bottom: 15rpx;
}

.recommended-name {
  display: block;
  font-size: 24rpx;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.recommended-price {
  font-size: 28rpx;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.9);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(212, 175, 55, 0.2);
  padding: 20rpx;
  z-index: 1000;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 10rpx;
  min-width: 100rpx;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 22rpx;
  color: #FFFFFF;
}

.favorite-btn.favorited .btn-text {
  color: #D4AF37;
}

.reserve-btn {
  flex: 1;
  flex-direction: row;
  background: linear-gradient(135deg, #D4AF37 0%, #F4E4A6 100%);
  border-radius: 50rpx;
  padding: 25rpx;
  margin-left: 20rpx;
}

.reserve-btn[disabled] {
  background: rgba(255, 255, 255, 0.1);
  color: #999999;
}

.reserve-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #000000;
}